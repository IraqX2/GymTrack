# Copy to .env for local development. Never commit the real .env file.
# Generate two different random values with at least 32 characters each.
JWT_SECRET_KEY=replace-with-a-unique-random-secret-of-32-or-more-characters
PASSWORD_PEPPER=replace-with-a-different-random-pepper-of-32-or-more-chars

# Use a hosted PostgreSQL URL for deployment. Leave empty for local SQLite.
DATABASE_URL=

# Comma-separated if the frontend is hosted on a different origin.
FRONTEND_ORIGIN=http://localhost:5173
